  ],
  "whatsapp_greeting": "\u0627\u0644\u0633\u0644\u0627\u0645 \u0639\u0644\u064a\u0643\u0645 \u0648\u0631\u062d\u0645\u0629 \u0627\u0644\u0644\u0647 \ud83c\udf1f\n\n\u0623\u0647\u0644\u0627\u064b \u0648\u0633\u0647\u0644\u0627\u064b \u0628\u0643 \u0641\u064a \u0634\u0631\u0643\u0629 \u0631\u0648\u064a\u0627\u0644 \u0644\u0644\u062a\u0646\u0638\u064a\u0641!\n\n\ud83d\udcde \u0644\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0645\u0628\u0627\u0634\u0631: 0563177803\n\u23f0 \u0646\u062e\u062f\u0645\u0643 24 \u0633\u0627\u0639\u0629 \u0641\u064a \u0643\u0644 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a\n\n\u0643\u064a\u0641 \u0623\u0642\u062f\u0631 \u0623\u0633\u0627\u0639\u062f\u0643 \u0627\u0644\u064a\u0648\u0645\u061f\n\n1\ufe0f\u20e3 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648\u0627\u0644\u0623\u0633\u0639\u0627\u0631\n2\ufe0f\u20e3 \u062d\u062c\u0632 \u062e\u062f\u0645\u0629 \u062c\u062f\u064a\u062f\u0629\n3\ufe0f\u20e3 \u0645\u062a\u0627\u0628\u0639\u0629 \u0637\u0644\u0628\n4\ufe0f\u20e3 \u0627\u0633\u062a\u0641\u0633\u0627\u0631 \u0622\u062e\u0631\n\n\u0627\u062e\u062a\u0631 \u0631\u0642\u0645 \u0623\u0648 \u0627\u0643\u062a\u0628 \u0637\u0644\u0628\u0643 \u0645\u0628\u0627\u0634\u0631\u0629 \ud83d\udc47"
}