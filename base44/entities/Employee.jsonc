{
  "name": "Employee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "role": {
      "type": "string",
      "enum": [
        "\u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645",
        "\u0645\u0634\u0631\u0641",
        "\u0645\u0648\u0638\u0641 \u062a\u0646\u0638\u064a\u0641",
        "\u062e\u062f\u0645\u0629 \u0639\u0645\u0644\u0627\u0621",
        "\u0645\u062f\u064a\u0631 \u0641\u0631\u0639"
      ],
      "default": "\u0645\u0648\u0638\u0641 \u062a\u0646\u0638\u064a\u0641",
      "description": "\u0627\u0644\u062f\u0648\u0631 \u0627\u0644\u0648\u0638\u064a\u0641\u064a"
    },
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0628\u064a",
        "\u0623\u0628\u0648\u0638\u0628\u064a",
        "\u0627\u0644\u0634\u0627\u0631\u0642\u0629",
        "\u0639\u062c\u0645\u0627\u0646",
        "\u0627\u0644\u0639\u064a\u0646",
        "\u0631\u0623\u0633 \u0627\u0644\u062e\u064a\u0645\u0629"
      ],
      "default": "\u062f\u0628\u064a",
      "description": "\u0627\u0644\u0641\u0631\u0639"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0646\u0634\u0637",
        "\u063a\u064a\u0631 \u0646\u0634\u0637",
        "\u0625\u062c\u0627\u0632\u0629"
      ],
      "default": "\u0646\u0634\u0637",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "tasks_completed": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0645\u0647\u0627\u0645 \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629"
    },
    "rating": {
      "type": "number",
      "default": 5,
      "description": "\u0627\u0644\u062a\u0642\u064a\u064a\u0645"
    },
    "salary": {
      "type": "number",
      "description": "\u0627\u0644\u0631\u0627\u062a\u0628"
    },
    "join_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "name",
    "phone",
    "role"
  ]
}