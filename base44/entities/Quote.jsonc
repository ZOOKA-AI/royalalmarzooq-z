{
  "name": "Quote",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0639\u0631\u0636 \u0627\u0644\u0633\u0639\u0631"
    },
    "client_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_phone": {
      "type": "string",
      "description": "\u0647\u0627\u062a\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      },
      "description": "\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629"
    },
    "subtotal": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0641\u0631\u0639\u064a"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u062e\u0635\u0645"
    },
    "tax": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0636\u0631\u064a\u0628\u0629"
    },
    "total": {
      "type": "number",
      "description": "\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0645\u0633\u0648\u062f\u0629",
        "\u0645\u0631\u0633\u0644",
        "\u0645\u0642\u0628\u0648\u0644",
        "\u0645\u0631\u0641\u0648\u0636",
        "\u0645\u0646\u062a\u0647\u064a"
      ],
      "default": "\u0645\u0633\u0648\u062f\u0629",
      "description": "\u062d\u0627\u0644\u0629 \u0639\u0631\u0636 \u0627\u0644\u0633\u0639\u0631"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "\u0635\u0627\u0644\u062d \u062d\u062a\u0649"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "terms": {
      "type": "string",
      "description": "\u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645"
    },
    "pdf_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 PDF"
    }
  },
  "required": [
    "client_name",
    "total"
  ]
}