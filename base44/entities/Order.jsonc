{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0637\u0644\u0628"
    },
    "client_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_phone": {
      "type": "string",
      "description": "\u0647\u0627\u062a\u0641 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "client_address": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "service_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062e\u062f\u0645\u0629"
    },
    "service_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u062e\u062f\u0645\u0629"
    },
    "worker_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0639\u0627\u0645\u0644"
    },
    "worker_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0627\u0645\u0644"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0648\u0639\u062f"
    },
    "scheduled_time": {
      "type": "string",
      "description": "\u0648\u0642\u062a \u0627\u0644\u0645\u0648\u0639\u062f"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u062c\u062f\u064a\u062f",
        "\u0645\u0624\u0643\u062f",
        "\u0642\u064a\u062f \u0627\u0644\u062a\u0646\u0641\u064a\u0630",
        "\u0645\u0643\u062a\u0645\u0644",
        "\u0645\u0644\u063a\u064a"
      ],
      "default": "\u062c\u062f\u064a\u062f",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628"
    },
    "price": {
      "type": "number",
      "description": "\u0627\u0644\u0633\u0639\u0631"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u062e\u0635\u0645"
    },
    "tax": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0636\u0631\u064a\u0628\u0629"
    },
    "total": {
      "type": "number",
      "description": "\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "\u063a\u064a\u0631 \u0645\u062f\u0641\u0648\u0639",
        "\u0645\u0639\u0644\u0642",
        "\u0645\u062f\u0641\u0648\u0639 \u062c\u0632\u0626\u064a\u0627\u064b",
        "\u0645\u062f\u0641\u0648\u0639",
        "\u0645\u0633\u062a\u0631\u062c\u0639"
      ],
      "default": "\u063a\u064a\u0631 \u0645\u062f\u0641\u0648\u0639",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "\u0646\u0642\u062f\u064a",
        "\u062a\u062d\u0648\u064a\u0644 \u0628\u0646\u0643\u064a",
        "\u0628\u0637\u0627\u0642\u0629",
        "Stripe",
        "PayPal",
        "Apple Pay",
        "Google Pay"
      ],
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "payment_gateway": {
      "type": "string",
      "description": "\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629"
    },
    "transaction_id": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629"
    },
    "payment_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062f\u0641\u0639"
    },
    "invoice_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629"
    },
    "invoice_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "rating": {
      "type": "number",
      "description": "\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    }
  },
  "required": [
    "client_name",
    "client_phone",
    "service_name"
  ]
}